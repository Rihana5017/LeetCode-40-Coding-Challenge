#include <stdlib.h>
#include <string.h>

void backtrack(int row, int n, char** board,
               int* cols, int* diag1, int* diag2,
               char**** result, int* returnSize,
               int** returnColumnSizes, int* capacity) {

    if (row == n) {

        if (*returnSize == *capacity) {
            *capacity *= 2;

            *result = realloc(*result,
                (*capacity) * sizeof(char**));

            *returnColumnSizes = realloc(
                *returnColumnSizes,
                (*capacity) * sizeof(int));
        }

        char** copy = malloc(n * sizeof(char*));

        for (int i = 0; i < n; i++) {
            copy[i] = malloc((n + 1) * sizeof(char));
            strcpy(copy[i], board[i]);
        }

        (*result)[*returnSize] = copy;
        (*returnColumnSizes)[*returnSize] = n;

        (*returnSize)++;
        return;
    }

    for (int col = 0; col < n; col++) {

        int d1 = row - col + n - 1;
        int d2 = row + col;

        if (cols[col] || diag1[d1] || diag2[d2])
            continue;

        board[row][col] = 'Q';

        cols[col] = 1;
        diag1[d1] = 1;
        diag2[d2] = 1;

        backtrack(row + 1, n, board,
                  cols, diag1, diag2,
                  result, returnSize,
                  returnColumnSizes, capacity);

        board[row][col] = '.';

        cols[col] = 0;
        diag1[d1] = 0;
        diag2[d2] = 0;
    }
}

char*** solveNQueens(int n, int* returnSize,
                     int** returnColumnSizes) {

    *returnSize = 0;

    int capacity = 16;

    char*** result = malloc(capacity * sizeof(char**));

    *returnColumnSizes = malloc(capacity * sizeof(int));

    char** board = malloc(n * sizeof(char*));

    for (int i = 0; i < n; i++) {
        board[i] = malloc((n + 1) * sizeof(char));

        memset(board[i], '.', n);
        board[i][n] = '\0';
    }

    int* cols = calloc(n, sizeof(int));
    int* diag1 = calloc(2 * n - 1, sizeof(int));
    int* diag2 = calloc(2 * n - 1, sizeof(int));

    backtrack(0, n, board,
              cols, diag1, diag2,
              &result, returnSize,
              returnColumnSizes, &capacity);

    for (int i = 0; i < n; i++)
        free(board[i]);

    free(board);
    free(cols);
    free(diag1);
    free(diag2);

    return result;
}
