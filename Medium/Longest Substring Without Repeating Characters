int lengthOfLongestSubstring(char* s) {

    int max = 0;
    int count;

    for (int i = 0; s[i] != '\0'; i++) {

        int visited[256] = {0};
        count = 0;

        for (int j = i; s[j] != '\0'; j++) {

            if (visited[(unsigned char)s[j]] == 1) {
                break;
            }

            visited[(unsigned char)s[j]] = 1;
            count++;
        }

        if (count > max) {
            max = count;
        }
    }

    return max;
}
